# .env.local.example — copy to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real secrets.

# ────────────────────────────────────────────────
# Neon — Dashboard > Connection Details
# ────────────────────────────────────────────────
# Pooled URL (hostname contains '-pooler') — used at runtime by lib/db
DATABASE_URL=postgres://your-pooler-url-here
# Direct URL (NO '-pooler' in hostname) — used by drizzle-kit push only
DIRECT_DATABASE_URL=postgres://your-direct-url-here

# ────────────────────────────────────────────────
# NextAuth — generate with `npx auth secret`
# ────────────────────────────────────────────────
AUTH_SECRET=replace_with_32_random_bytes
# AUTH_URL=https://your-canonical-app-url  # optional — auto-detected on Vercel

# ────────────────────────────────────────────────
# Uploadthing — Dashboard > API Keys > V7 tab
# ────────────────────────────────────────────────
UPLOADTHING_TOKEN=your_v7_token_here

# ────────────────────────────────────────────────
# Paystack — Dashboard > Settings > API Keys & Webhooks
# ────────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_WEBHOOK_SECRET=your_webhook_signing_secret

# ────────────────────────────────────────────────
# Resend — resend.com > API Keys
# ────────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=orders@rodoandco.com
ADMIN_NOTIFICATION_EMAIL=admin@rodoandco.com

# ────────────────────────────────────────────────
# Admin seed (seed-time only — used by `npm run seed:admin`)
# ────────────────────────────────────────────────
# Minimum complexity: ≥ 12 chars, mixed case + digits + symbols
ADMIN_EMAIL=admin@rodoandco.com
ADMIN_PASSWORD=replace_with_strong_password

# ────────────────────────────────────────────────
# Vercel Cron — any strong random string
# ────────────────────────────────────────────────
CRON_SECRET=replace_with_strong_random_value

# ────────────────────────────────────────────────
# App
# ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
